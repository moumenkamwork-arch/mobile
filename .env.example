# ============================================
# Promoo Mobile — Environment Variables
# ============================================
# Copy this file to .env and fill in real values. .env is gitignored.

# Backend API base URL lives in lib/core/config/app_config.dart
# (AppConfig.defaultBaseUrl). Override at build time with:
#   --dart-define=PROMOO_BASE_URL=https://...

# Supabase (used directly by the app for Realtime — chat live messages)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App Settings
PROMOO_FALLBACK_CURRENCY=AED
