# ============================================
# Promoo Mobile — Environment Variables
# ============================================
# Copy this file to .env and fill in real values. .env is gitignored.

# Backend API
PROMOO_BASE_URL=http://localhost:3000/api/v1

# Supabase (used directly by the app for Realtime — chat live messages)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App Settings
PROMOO_FALLBACK_CURRENCY=AED
