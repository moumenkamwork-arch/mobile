<?xml version="1.0" encoding="utf-8"?>
<!-- Notification small icon. Must be a flat white silhouette on transparent —
     Android ignores color and renders only the alpha channel as the status-bar
     glyph (tinted via android:colorNotification / the notification_color
     resource), which is exactly why using a full-color launcher PNG directly
     here rendered as a plain blob. Shape mirrors the brand "P" mark
     (assets/brand/new_logo/promoo_mark.png): stem + open bowl + the two accent
     dots at the base and inside the counter. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M5,3 L9,3 L9,21 L5,21 Z" />
  <path
      android:fillColor="#FFFFFF"
      android:fillType="evenOdd"
      android:pathData="M9,3 L14,3 A5,5 0 0 1 14,13 L9,13 Z M9,5.2 L12.8,5.2 A2.8,2.8 0 0 1 12.8,10.8 L9,10.8 Z" />
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M4.4,20 A2.6,2.6 0 1,0 9.6,20 A2.6,2.6 0 1,0 4.4,20 Z" />
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M9.7,8 A1.8,1.8 0 1,0 13.3,8 A1.8,1.8 0 1,0 9.7,8 Z" />
</vector>
